# Copiați acest fișier ca .env și completați valorile. NU urcați .env pe Git!
# Furnizorul folosit: gemini | mistral | ollama | lmstudio
LLM_PROVIDER=gemini

# Cheile (necesare doar pentru furnizorii în cloud)
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Opțional: suprascrieți modelul sau adresa de bază a furnizorului
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=http://localhost:11434/v1
